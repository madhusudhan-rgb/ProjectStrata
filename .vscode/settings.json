{
    // Use the CMakePresets.json in the repo root (debug/release) instead of
    // letting the extension guess a kit
    "cmake.useCMakePresets": "always",
    "cmake.configureOnOpen": true,
    // Make sure the CMake/Ninja/MinGW binaries from the Qt install are findable
    "cmake.environment": {
        "PATH": "C:\\Qt\\Tools\\Ninja;C:\\Qt\\Tools\\mingw1310_64\\bin;${env:PATH}"
    },
    // IntelliSense reads the compile_commands.json generated by the debug preset
    "C_Cpp.default.compileCommands": "${workspaceFolder}/build/debug/compile_commands.json"
}
