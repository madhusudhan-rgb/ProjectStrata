{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run & Debug Strata (debug build)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/Strata.exe",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Strata (debug)",
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\Qt\\Tools\\mingw1310_64\\bin\\gdb.exe",
            "console": "internalConsole",
            // Qt DLLs must be on PATH or the exe won't start outside Qt Creator
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\Qt\\6.11.2\\mingw_64\\bin;C:\\Qt\\Tools\\mingw1310_64\\bin;${env:PATH}"
                }
            ]
        },
        {
            "name": "Run Strata (debug build, no debugger)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/Strata.exe",
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "Build Strata (debug)",
            "MIMode": "gdb",
            "miDebuggerPath": "C:\\Qt\\Tools\\mingw1310_64\\bin\\gdb.exe",
            "console": "internalConsole",
            "environment": [
                {
                    "name": "PATH",
                    "value": "C:\\Qt\\6.11.2\\mingw_64\\bin;C:\\Qt\\Tools\\mingw1310_64\\bin;${env:PATH}"
                }
            ],
            "noDebug": true
        }
    ]
}
